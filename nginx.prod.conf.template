# Serving model: real crawlers (matched by user-agent below) get the prerendered
# static file from `${VAR_DIR}/seo/` for SEO; every human — anonymous OR logged-in
# — gets the live CSR SPA, which renders the full layout client-side. (A prior
# cookie-based rule served anonymous humans the content-only prerender → a
# layout-less page, and its `rewrite ^ /index.html last` looped → 500 on every
# authed request. Both are fixed here.)
# Adding/removing a post is a file in `/usr/share/nginx/seo/`;
# toggling `seo.mode` is a backend flag — NEITHER needs an nginx reload.
# `${VAR_DIR}/seo` is bind-mounted read-only at /usr/share/nginx/html/seo so the
# `try_files /seo$uri.html` lookup (rooted at /usr/share/nginx/html) resolves it.
# Crawlers (no JS) get the prerendered SEO snapshot under /seo; every human —
# anonymous OR logged-in — gets the live SPA, which renders the full layout
# client-side. Serving the content-only prerender to humans left them on an
# unstyled, layout-less page: the SPA can't cleanly take over a #app that the
# prerender already filled with bare content. $seo_prefix is "/seo" only for
# crawler user-agents; empty for everyone else.
map $http_user_agent $seo_prefix {
    default "";
    "~*(bot|crawl|spider|slurp|mediapartners|googlebot|bingbot|yandex|baiduspider|duckduckbot|facebookexternalhit|twitterbot|linkedinbot|telegrambot|whatsapp|discordbot|slackbot|embedly|pinterest|redditbot|curl|wget|python-requests|headlesschrome)" "/seo";
}

# S118 Track B — dynamic full-page rendering for crawlers.
# A crawler is served a LIVE headless render of the fe-user SPA (full layout +
# content), produced by the backend `/_seo-render` route (which caches + minifies)
# — NOT the content-only static prerender. Humans are unaffected (live SPA).
#   $ua_crawler          — 1 for crawler user-agents (same set as $seo_prefix).
#   $vbwd_render_loopback— 1 when the request carries the renderer's own loop-guard
#                          header (X-VBWD-Render); such fetches MUST get the SPA
#                          shell so the renderer can render it — never re-routed.
#   ${SEO_RENDER_ON}     — "1" only when the feature is enabled for this instance
#                          (env, default "0"). When "0" the crawler branch is a
#                          pure no-op: crawlers get the static prerender exactly as
#                          before, with NO backend round-trip and NO redirect loop.
#   $serve_dynamic_render— 1 only for a crawler, NOT the renderer loopback, AND on.
map $http_user_agent $ua_crawler {
    default 0;
    "~*(bot|crawl|spider|slurp|mediapartners|googlebot|bingbot|yandex|baiduspider|duckduckbot|facebookexternalhit|twitterbot|linkedinbot|telegrambot|whatsapp|discordbot|slackbot|embedly|pinterest|redditbot|curl|wget|python-requests|headlesschrome)" 1;
}
map $http_x_vbwd_render $vbwd_render_loopback {
    default 0;
    "~.+"   1;
}
map "${ua_crawler}${vbwd_render_loopback}${SEO_RENDER_ON}" $serve_dynamic_render {
    default 0;
    "101"   1;
}

server {
    listen 80;

    # Allow large image uploads (raw photo / base64-inflated e2e ciphertext).
    # Must exceed meinchat `attachment_max_bytes` (25 MB) + ~33% base64 overhead.
    client_max_body_size 40m;

    # Use docker's internal resolver and runtime variables so missing upstreams
    # (e.g. plugin-api not yet up, or absent in older instance composes) cause
    # a 502 at request time instead of preventing nginx from starting.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream ${API_UPSTREAM};
    set $plugin_api_upstream ${PLUGIN_API_UPSTREAM};

    # Proxy uploaded media files to backend
    location /uploads/ {
        proxy_pass http://$api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
    }

    # SEO — sitemap + robots are DYNAMIC backend routes (cms plugin) served at
    # root; proxy them to the backend so they don't fall through to the SPA.
    location = /sitemap.xml {
        proxy_pass http://$api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
    }
    location ~ ^/sitemap-\d+\.xml$ {
        proxy_pass http://$api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
    }
    location = /robots.txt {
        proxy_pass http://$api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
    }

    # IndexNow key-verification file, served at the site ROOT as /<key>.txt by the
    # cms plugin (like robots.txt/sitemap.xml). The 8-128-char match excludes
    # /robots.txt (6 chars). Backend 404s unless <key> matches the configured key.
    location ~ "^/[A-Za-z0-9-]{8,128}\.txt$" {
        proxy_pass http://$api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
    }

    # Server-Sent Events stream — MUST NOT be buffered, or the browser only
    # sees new messages on refresh (iOS uses polling and is unaffected). Disable
    # buffering at this hop AND re-assert `X-Accel-Buffering: no` downstream so
    # the front (Hestia) proxy streams too — nginx consumes the api's header and
    # does not forward it. Exact-match `=` ignores the `?stream_token=…` query.
    location = /api/v1/messaging/stream {
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        add_header X-Accel-Buffering no always;
    }

    # Proxy all /api/ requests to the backend container
    location /api/ {
        proxy_pass http://$api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
    }

    # Proxy /_plugins/* to the plugin-api sidecar (HMAC-authenticated endpoint
    # called by the fe-admin User Plugins tab).
    location /_plugins {
        proxy_pass http://$plugin_api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
    }

    # SPA + prerender serving.
    #   - logged-in (vbwd_session) → live CSR SPA (cache-bypass);
    #   - anonymous/bot → the prerendered `/seo/<slug>.html` if present, else the
    #     real path (assets), else the SPA shell.
    # `${VAR_DIR}/seo` is bind-mounted read-only at /usr/share/nginx/html/seo
    # (shared with the backend prerender writer). Content changes never touch
    # this conf.
    location / {
        root /usr/share/nginx/html;
        index index.html;
        # Crawlers (not the renderer's own loopback) → dynamic full-page render
        # via the backend `/_seo-render` route (@seo_dynamic). Everyone else —
        # humans, and the renderer's loopback fetch — falls through to try_files:
        # $seo_prefix="/seo" only for crawlers (static prerender), "" for humans
        # (SPA shell). `return` inside `if` is one of the safe `if` uses.
        error_page 418 = @seo_dynamic;
        if ($serve_dynamic_render) { return 418; }
        try_files ${seo_prefix}$uri.html ${seo_prefix}$uri/index.html $uri /index.html;
    }

    # Dynamic full-page render for crawlers. Proxies to the backend on-demand
    # renderer route (which caches + minifies). The path is passed as ?path=$uri
    # — query args are dropped on purpose so the render cache is not fragmented by
    # query strings. The shared secret token (injected here, matched by the backend
    # `seo_render_internal_token`) gates the route; an empty token ⇒ backend 404 ⇒
    # graceful fallback below, so the feature is OFF until a token is configured.
    location @seo_dynamic {
        proxy_pass http://$api_upstream/api/v1/cms/_seo-render?path=$uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-VBWD-Render-Token "${SEO_RENDER_TOKEN}";
        # A cold headless render can take a few seconds; keep it bounded.
        proxy_read_timeout 35s;
        # Backend returns 404 (feature off / bad token) or 5xx (renderer miss/down)
        # → serve the static prerender, then the SPA shell. The site never 5xx's to
        # a crawler because of the renderer.
        proxy_intercept_errors on;
        error_page 404 500 502 503 504 = @seo_static;
    }

    # Static fallback for crawlers when the render misses/errs: the content-only
    # prerender file if present, else the SPA shell — via @seo_shell so the shell
    # is served WITHOUT re-entering `location /` (which would re-trigger the
    # crawler → @seo_dynamic branch and loop into a redirect cycle → 404/500).
    location @seo_static {
        root /usr/share/nginx/html;
        try_files ${seo_prefix}$uri.html ${seo_prefix}$uri/index.html $uri @seo_shell;
    }
    location @seo_shell {
        root /usr/share/nginx/html;
        try_files /index.html =404;
    }
}
