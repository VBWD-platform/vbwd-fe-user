# Serving model: real crawlers (matched by user-agent below) get the prerendered
# static file from `${VAR_DIR}/seo/` for SEO; every human — anonymous OR logged-in
# — gets the live CSR SPA, which renders the full layout client-side. (A prior
# cookie-based rule served anonymous humans the content-only prerender → a
# layout-less page, and its `rewrite ^ /index.html last` looped → 500 on every
# authed request. Both are fixed here.)
# Adding/removing a post is a file in `/usr/share/nginx/seo/`;
# toggling `seo.mode` is a backend flag — NEITHER needs an nginx reload.
# `${VAR_DIR}/seo` is bind-mounted read-only at /usr/share/nginx/html/seo so the
# `try_files /seo$uri.html` lookup (rooted at /usr/share/nginx/html) resolves it.
# Crawlers (no JS) get the prerendered SEO snapshot under /seo; every human —
# anonymous OR logged-in — gets the live SPA, which renders the full layout
# client-side. Serving the content-only prerender to humans left them on an
# unstyled, layout-less page: the SPA can't cleanly take over a #app that the
# prerender already filled with bare content. $seo_prefix is "/seo" only for
# crawler user-agents; empty for everyone else.
map $http_user_agent $seo_prefix {
    default "";
    "~*(bot|crawl|spider|slurp|mediapartners|googlebot|bingbot|yandex|baiduspider|duckduckbot|facebookexternalhit|twitterbot|linkedinbot|telegrambot|whatsapp|discordbot|slackbot|embedly|pinterest|redditbot|curl|wget|python-requests|headlesschrome)" "/seo";
}

server {
    listen 80;

    # Allow large image uploads (raw photo / base64-inflated e2e ciphertext).
    # Must exceed meinchat `attachment_max_bytes` (25 MB) + ~33% base64 overhead.
    client_max_body_size 40m;

    # Use docker's internal resolver and runtime variables so missing upstreams
    # (e.g. plugin-api not yet up, or absent in older instance composes) cause
    # a 502 at request time instead of preventing nginx from starting.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream ${API_UPSTREAM};
    set $plugin_api_upstream ${PLUGIN_API_UPSTREAM};

    # Proxy uploaded media files to backend
    location /uploads/ {
        proxy_pass http://$api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
    }

    # SEO — sitemap + robots are DYNAMIC backend routes (cms plugin) served at
    # root; proxy them to the backend so they don't fall through to the SPA.
    location = /sitemap.xml {
        proxy_pass http://$api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
    }
    location ~ ^/sitemap-\d+\.xml$ {
        proxy_pass http://$api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
    }
    location = /robots.txt {
        proxy_pass http://$api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
    }

    # Server-Sent Events stream — MUST NOT be buffered, or the browser only
    # sees new messages on refresh (iOS uses polling and is unaffected). Disable
    # buffering at this hop AND re-assert `X-Accel-Buffering: no` downstream so
    # the front (Hestia) proxy streams too — nginx consumes the api's header and
    # does not forward it. Exact-match `=` ignores the `?stream_token=…` query.
    location = /api/v1/messaging/stream {
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        add_header X-Accel-Buffering no always;
    }

    # Proxy all /api/ requests to the backend container
    location /api/ {
        proxy_pass http://$api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
    }

    # Proxy /_plugins/* to the plugin-api sidecar (HMAC-authenticated endpoint
    # called by the fe-admin User Plugins tab).
    location /_plugins {
        proxy_pass http://$plugin_api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
    }

    # SPA + prerender serving.
    #   - logged-in (vbwd_session) → live CSR SPA (cache-bypass);
    #   - anonymous/bot → the prerendered `/seo/<slug>.html` if present, else the
    #     real path (assets), else the SPA shell.
    # `${VAR_DIR}/seo` is bind-mounted read-only at /usr/share/nginx/html/seo
    # (shared with the backend prerender writer). Content changes never touch
    # this conf.
    location / {
        root /usr/share/nginx/html;
        index index.html;
        # Crawlers ($seo_prefix="/seo") resolve the prerendered /seo/<slug>.html
        # for SEO; humans ($seo_prefix="") fall straight through to /index.html —
        # the SPA shell — which renders the complete layout. Real asset paths
        # ($uri) still resolve before the /index.html fallback.
        try_files ${seo_prefix}$uri.html ${seo_prefix}$uri/index.html $uri /index.html;
    }
}
