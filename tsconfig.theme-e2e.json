{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "typeRoots": ["./node_modules/@types"],
    "types": ["node"],
    "paths": {
      "@playwright/test": ["./node_modules/@playwright/test"],
      "@fe-user-e2e/*": ["./vue/tests/e2e/*"]
    }
  },
  "include": [
    "playwright.theme.config.ts",
    "../vbwd-backend/plugins/theme*/tests/e2e/**/*.ts"
  ]
}
